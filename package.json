{
  "name": "common-air",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Common Air: a real-time data art installation. 14 European cities as generative point clouds driven by live air quality and weather.",
  "scripts": {
    "dev": "node server/index.js",
    "start": "vite build && node server/index.js --serve-dist",
    "build": "vite build",
    "build:data": "node tools/build-europe.mjs && node tools/build-cities.mjs",
    "build:europe": "node tools/build-europe.mjs",
    "build:cities": "node tools/build-cities.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.2",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "world-atlas": "^2.0.2",
    "ws": "^8.22.2"
  }
}
